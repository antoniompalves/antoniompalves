# Copie para .env (na mesma pasta que app.js) ou defina em cPanel → Setup Node.js App → Environment variables.

# Palavra-passe para entrar na aplicação (obrigatória quando está online).
APP_PASSWORD=mude-isto

# Texto aleatório para assinar o cookie de sessão. Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Só se a aplicação estiver num subcaminho, ex.: https://seudominio.pt/vroom  →  BASE_PATH=/vroom
BASE_PATH=

# Onde ficam os dados (relativo a app.js). Mantenha fora de public_html.
DATA_DIR=data

# Opcional: permite ao servidor obter páginas do leboncoin via Firecrawl quando o leboncoin o bloqueia (HTTP 403).
FIRECRAWL_API_KEY=
