# Kataru server: accounts and the shared workspace (docs/ACCOUNTS.md) and publishing
# (docs/PUBLISHING.md). Copy to server/.env and fill in. On cPanel, see docs/CPANEL.md.

# ── Accounts and the shared workspace ──
# Seals two-step secrets and network tokens. At least 32 characters: openssl rand -base64 32
KATARU_SECRET=
# Where the server is reached (links in emails, single sign-on, OAuth redirects, media URLs).
KATARU_PUBLIC_URL=http://localhost:8787
# SQLite (a file; Node 22.13+) or MySQL/MariaDB: mysql://user:password@localhost:3306/kataru
DATABASE_URL=sqlite:./.publisher-data/kataru.db
# Serve the built app (npm run build → dist) from this server, at one address.
KATARU_STATIC_DIR=
# When the app lives under a path, e.g. /kataru
KATARU_BASE_PATH=
# Asked once, on the setup screen; printed in the log when empty.
KATARU_SETUP_CODE=
# Email for invitations and password resets: smtps://user%40domain:password@host:465 or smtp://…:587
SMTP_URL=
MAIL_FROM=Kataru <no-reply@example.com>
# Single sign-on (any of the three). Redirect URI: <public url>/api/auth/sso/<google|microsoft|oidc>/callback
KATARU_SSO_GOOGLE_CLIENT_ID=
KATARU_SSO_GOOGLE_CLIENT_SECRET=
KATARU_SSO_MICROSOFT_TENANT=
KATARU_SSO_MICROSOFT_CLIENT_ID=
KATARU_SSO_MICROSOFT_CLIENT_SECRET=
KATARU_SSO_OIDC_ISSUER=
KATARU_SSO_OIDC_CLIENT_ID=
KATARU_SSO_OIDC_CLIENT_SECRET=
KATARU_SSO_OIDC_NAME=SSO
# Email domains whose people may join through SSO without an invitation, and their role.
KATARU_SSO_DOMAINS=
KATARU_SSO_ROLE=analyst

# ── Publishing ──

# Where this service is reachable from the internet (OAuth redirects and media URLs use it).
# The older name for KATARU_PUBLIC_URL (either works).
PUBLISHER_PUBLIC_URL=
PUBLISHER_PORT=8787
# The Kataru app's origin(s), comma-separated: CORS and the sign-in popup only talk to these.
PUBLISHER_APP_ORIGIN=https://app.example.com
# Only for other services calling the publishing API ("Authorization: Bearer …"); people
# signed in use their session. Long and random: openssl rand -base64 32
PUBLISHER_API_KEY=
# The older name for KATARU_SECRET (either works).
PUBLISHER_SECRET=
PUBLISHER_DATA_DIR=./.publisher-data
PUBLISHER_MAX_MEDIA_MB=512
# Full-size originals nobody scheduled are deleted after this many days (light copies stay; docs/DATA.md).
PUBLISHER_KEEP_ORIGINAL_DAYS=30

# Meta: Facebook Pages + Instagram (Facebook Login for Business)
META_APP_ID=
META_APP_SECRET=
# Optional: a Facebook Login for Business configuration instead of a scope list
META_CONFIG_ID=
META_GRAPH_VERSION=v26.0

# Threads (its own app id/secret, from the Threads use case)
THREADS_APP_ID=
THREADS_APP_SECRET=

# LinkedIn
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_VERSION=202609
# true once the Community Management API is approved: lists and posts to Company Pages
LINKEDIN_ORGANIZATIONS=false

# TikTok (Content Posting API)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# URL prefixes verified in the TikTok developer portal, comma-separated (needed for photo posts)
TIKTOK_PULL_PREFIXES=

# YouTube (Google Cloud OAuth client, YouTube Data API v3 enabled)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
