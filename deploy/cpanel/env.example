# Copia para ~/gohan/.env (o ficheiro fica fora da pasta pública). Também podes pôr estas variáveis
# no ecrã "Setup Python App" → Environment variables; as de lá têm prioridade.

# Chave da API da Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=
# Código para criares a tua conta (campo "Convite ou código"). Os amigos entram com o convite do grupo.
SIGNUP_CODE=troca-isto-por-um-codigo
# Contacto para as notificações push
VAPID_SUBJECT=mailto:o-teu-email@exemplo.pt

# Onde ficam os dados (fora de public_html). Por omissão: ~/gohan-data
# RECIPES_DB=/home/OTEUUTILIZADOR/gohan-data/recipes.db

TZ=Europe/Lisbon
RECIPE_MODEL=claude-opus-5-5
RECIPE_EFFORT=medium
# Alojamento partilhado: atualização por consulta periódica e resumo semanal por Cron Job
REALTIME=poll
WEEKLY_DIGEST=0
