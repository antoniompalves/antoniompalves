# ---------------------------------------------------------------- obrigatório
# Domínio (ou subdomínio) já apontado para o IP deste servidor (registo A/AAAA)
DOMAIN=gohan.exemplo.pt
# Email para o certificado HTTPS (Let's Encrypt avisa antes de expirar)
ACME_EMAIL=
# Chave da API da Anthropic (console.anthropic.com) — importação de receitas e conversor Bimby
ANTHROPIC_API_KEY=
# Código de registo: a primeira conta (a tua) é criada com ele, no campo "Convite ou código".
# Os amigos entram com o convite do grupo. Gerado pelo install.sh; guarda-o.
SIGNUP_CODE=
# Contacto incluído nas notificações push (exigido pelos serviços da Apple/Google)
VAPID_SUBJECT=mailto:admin@exemplo.pt

# ---------------------------------------------------------------- opcional
TZ=Europe/Lisbon
# Modelo e esforço da IA
RECIPE_MODEL=claude-opus-5-5
RECIPE_EFFORT=medium
BIMBY_EFFORT=medium
# Resumo semanal por notificação ao domingo às 18h (1 = ligado)
WEEKLY_DIGEST=1
# Mapear ingredientes desconhecidos para preços/calorias com IA (1 = ligado)
INGREDIENT_LLM_MAPPING=1
# Vídeos mais longos do que isto (segundos) não são descarregados
MAX_VIDEO_SECONDS=1200
# Instagram/TikTok às vezes pedem sessão: ficheiro de cookies (formato Netscape) dentro de /data
# YTDLP_COOKIES_FILE=/data/cookies.txt
# Documentação da API em /docs (0 = desligada)
ENABLE_DOCS=0
